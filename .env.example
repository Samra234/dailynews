# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GNews API Key: Optional. If provided, pulls live news from https://gnews.io
# Free tier allows 100 requests/day. If omitted, uses high-fidelity live Google News RSS feeds.
GNEWS_API_KEY=""

# NewsAPI.org API Key: Optional alternative provider from https://newsapi.org
NEWS_API_KEY=""

# Port for Express server
PORT=3000
